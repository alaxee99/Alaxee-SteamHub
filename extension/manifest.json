{
  "manifest_version": 3,
  "name": "ALAXEE SteamHub",
  "version": "0.3.0",
  "description": "Simplified Chinese localization and exact-match translation for Steam Community Market pages.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://steamcommunity.com/market",
        "https://steamcommunity.com/market/*",
        "https://www.steamcommunity.com/market",
        "https://www.steamcommunity.com/market/*"
      ],
      "js": [
        "market-locale.js",
        "core/item-identity.js",
        "core/translation-engine.js",
        "core/rate-limiter.js",
        "market-items.js",
        "storage-adapter.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ]
}
